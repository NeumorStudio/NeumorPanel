# --- Auth.js + GitHub OAuth ---
# Genera uno con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=
# https://github.com/settings/developers -> New OAuth App
#   Homepage URL:  http://localhost:3000
#   Callback URL:  http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Usuarios de GitHub (separados por comas) que pueden entrar la primera vez.
# Después se invita al resto desde Ajustes.
ALLOWED_GITHUB_USERS=tu-usuario,usuario-de-tu-companero

# --- Base de datos (solo online). Sin esto se usa data/db.json en local ---
# DATABASE_URL=postgres://...

# --- Capturas de las fichas (solo online). Sin esto se guardan en data/capturas/ ---
# En Vercel: Storage -> Create -> Blob, acceso PRIVADO, y conectarlo a este proyecto.
# Vercel añade solo BLOB_STORE_ID (entra con OIDC, sin clave que copiar).
# BLOB_STORE_ID=
